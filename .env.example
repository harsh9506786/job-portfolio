# Copy to .env.local and fill in. Never commit .env.local.

# Public site URL (used for canonical, sitemap, Open Graph, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# WhatsApp number: digits only with country code, no "+"  e.g. 919876543210
NEXT_PUBLIC_WHATSAPP_NUMBER=917225037332

# Shown in the Contact section only when set
NEXT_PUBLIC_CONTACT_EMAIL=sharmaharshvardhan2805@gmail.com
NEXT_PUBLIC_LINKEDIN_URL=https://www.linkedin.com/in/harshvardhan-sharma-9782a7189
NEXT_PUBLIC_INSTAGRAM_URL=

# Contact form delivery (https://resend.com): without these the form honestly
# reports "not sent" and offers WhatsApp instead of faking success.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Save every enquiry to a Google Sheet through n8n (optional): the n8n Webhook node's
# Production URL. Leave empty to skip. The secret is optional (n8n Header Auth, header name
# x-webhook-secret).
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# AI Project Brief (https://aistudio.google.com): without the key the section honestly
# says the AI is not connected yet. The key stays on the server, never in the browser.
GEMINI_API_KEY=
# Optional. Default: gemini-2.5-flash. Change it if Google retires that model.
GEMINI_MODEL=
